{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/posts",
      "destination": "/#writing",
      "permanent": true
    },
    {
      "source": "/tags",
      "destination": "/#writing",
      "permanent": true
    }
  ]
}
